{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "./",            // Look at the root folder
    "outDir": "./dist",         // Put everything compiled into /dist
    "strict": true,
    "sourceMap": true,
    "declaration": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "**/*.ts"                   // Include every TS file in every folder
  ],
  "exclude": [
    "node_modules",
    "dist"                      // Don't try to compile the output folder
  ]
}